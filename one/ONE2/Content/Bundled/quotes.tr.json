      "timeOfDay": "any",
      "premium": true,
      "active": true,
      "addedIn": 1,
      "lang": "tr"
    },
    {
      "id": "q_000016",
      "text": "Merak ettiğin şeye bir adım daha yaklaş.",
      "kind": "affirmation",
      "license": "original",
      "themes": [
        "merak",
        "cesaret"
      ],
      "paths": [
        "cesur"
