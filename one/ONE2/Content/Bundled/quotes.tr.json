        1,
        2
      ],
      "timeOfDay": "any",
      "premium": false,
      "active": true,
      "addedIn": 1,
      "lang": "tr"
    },
    {
      "id": "q_000011",
      "text": "Küçük bir adım da sayılır.",
      "kind": "affirmation",
      "license": "original",
      "themes": [
        "cesaret"
      ],
      "paths": [
        "cesur",
        "uretken"
      ],
      "emotionFit": [],
      "moodFit": [
        1,
        2,
        3
      ],
      "timeOfDay": "any",
      "premium": false,
      "active": true,
      "addedIn": 1,
      "lang": "tr"
    },
    {
      "id": "q_000012",
      "text": "Kendine bir arkadaşına konuştuğun gibi konuşabilirsin.",
      "kind": "affirmation",
      "license": "original",
      "themes": [
        "ozsefkat"
      ],
      "paths": [
        "sefkatli"
      ],
      "emotionFit": [
        "huzun"
      ],
      "moodFit": [
        1,
        2,
        3
      ],
      "timeOfDay": "any",
      "premium": false,
      "active": true,
      "addedIn": 1,
      "lang": "tr"
    },
    {
      "id": "q_000013",
      "text": "Dinlenmek de işin bir parçası.",
      "kind": "affirmation",
      "license": "original",
      "themes": [
        "dinlenme"
      ],
      "paths": [
        "sakin",
        "uretken"
      ],
      "emotionFit": [
        "yorgunluk"
      ],
      "moodFit": [
        1,
        2,
        3
      ],
      "timeOfDay": "any",
      "premium": false,
      "active": true,
      "addedIn": 1,
      "lang": "tr"
    },
    {
      "id": "q_000014",
      "text": "Bugün yalnızca bugünü taşıman yeterli.",
      "kind": "affirmation",
      "license": "original",
      "themes": [
        "kabul",
        "yavaslik"
      ],
      "paths": [
        "sakin",
        "sefkatli"
      ],
      "emotionFit": [
        "kaygi"
      ],
      "moodFit": [
        1,
        2
      ],
      "timeOfDay": "any",
      "premium": false,
      "active": true,
      "addedIn": 1,
      "lang": "tr"
    },
    {
      "id": "q_000015",
      "text": "Sınır koymak sevgisizlik değildir.",
      "kind": "affirmation",
      "license": "original",
      "themes": [
        "sinirlar"
      ],
      "paths": [
        "cesur",
        "sefkatli"
      ],
